# WordPress REST API base used at build time to fetch the latest articles
# for the home page's Expert Articles section.
# Example: https://cms.elitefitness.com/wp-json/wp/v2
# Leave unset to use the static fallback data in src/data/home.ts.
WP_API_BASE=https://www.elitefitness.com/articles/wp-json/wp/v2

# Set to 1 to fetch live "recent forum posts" at build time from each forum
# section's RSS feed. Leave unset to use the static fallback data in
# src/data/home.ts.
FORUM_RSS_ENABLED=1

# Set to 1 to fetch the live member/post counts shown in the homepage top
# banner, scraped at build time from the forum index's "Forum statistics"
# widget. Leave unset to use the static fallback data in src/data/home.ts.
FORUM_STATS_ENABLED=1
