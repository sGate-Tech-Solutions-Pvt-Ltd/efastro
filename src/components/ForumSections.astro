---
import { forumSections, THEME_IMG } from "../data/home";
---
<div class="outer-wide-wrap">
  {forumSections.map((sec) => (
    <div class={`wide-wrap ${sec.classes}`}>
      <div class="content-sidebar-wrap forum-posts">
        <div class="headline">RECENT FORUM POSTS</div>
        <div class="forum-category">
          <h2><a style="font-weight:bold;font-size:30px;color:#fff;" href={sec.href}>{sec.name}</a></h2>
        </div>
        {sec.posts.map((p) => (
          <section class="forum-post">
            <h3><a href={p.href}>{p.title}</a></h3>
            <header>
              <div class="date">{p.date}</div>
              <div class="author-avatar">
                <img src={`${THEME_IMG}/avatar.jpg`} width="64" height="64" alt={`Forum member ${p.author}`} loading="lazy" />
              </div>
              <div class="author-meta">
                <div class="meta-author">
                  <div class="meta-name">POST BY</div>
                  <div class="meta-value">{p.author}</div>
                </div>
              </div>
            </header>
            <div class="excerpt"><p>{p.excerpt}</p></div>
            <div class="read-more"><a href={p.href}>READ MORE</a></div>
          </section>
        ))}
      </div>
    </div>
  ))}
</div>
