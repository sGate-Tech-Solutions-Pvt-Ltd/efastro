---
// AWeber opt-in popup from the original page. Hidden by default; any element
// with [data-open-lead] opens it.
---
<div id="light" class="white_content" role="dialog" aria-modal="true" aria-labelledby="leadpages-form-title">
  <div style="padding-bottom:0;padding-top:12px;" id="leadpages-form-wrapper">
    <form method="post" id="leadpages-form" class="form-horizontal af-form-wrapper"
      style="background-color:#fff;border:1pt solid #fff;" accept-charset="UTF-8"
      action="https://www.aweber.com/scripts/addlead.pl">
      <a href="javascript:void(0)" data-close-lead id="leadpages-close-button" aria-label="Close">x</a>
      <div id="leadpages-form-header">
        <img src="/forum/aweberassets/statusbar-aweber.gif" alt="" loading="lazy" />
        <div id="leadpages-form-header-text" style="font-family:Helvetica,Arial,sans-serif;font-size:10pt;display:block">
          Almost there! Please complete this form and click the button below to gain instant access.
        </div>
      </div>
      <img id="leadpages-form-image" src="/forum/aweberassets/product-aweber-popup.jpg" alt="" loading="lazy" />
      <div class="leadbox-content-wrapper">
        <div id="leadpages-form-title" style="font-family:Tahoma,Geneva,sans-serif;font-size:18pt;display:block">
          <div><b>EliteFitness.com FREE Email Series: How You Can Use Winstrol, Masteron, HGH, and Testosterone for a Perfect, Muscular Physique!</b></div>
        </div>
        <div id="leadpages-fieldset-wrapper">
          <fieldset id="leadpages-fieldset">
            <div style="display:none;">
              <input type="hidden" name="meta_web_form_id" value="207130464" />
              <input type="hidden" name="meta_split_id" value="" />
              <input type="hidden" name="listname" value="awlist4541190" />
              <input type="hidden" name="redirect" value="https://www.elitefitness.com/join/confirm/" />
              <input type="hidden" name="meta_adtracking" value="Elitefitness_Report_Form" />
              <input type="hidden" name="meta_message" value="1" />
              <input type="hidden" name="meta_required" value="name,email" />
              <input type="hidden" name="meta_tooltip" value="" />
            </div>
            <div class="control-group">
              <div class="controls"><input name="name" placeholder="Name" type="text" required aria-label="Name" /></div>
            </div>
            <div class="control-group">
              <div class="controls"><input name="email" placeholder="Your Best Email" type="email" required aria-label="Email" /></div>
            </div>
            <div class="control-group">
              <div class="controls">
                <button id="leadpages-submit-button" type="submit"
                  style="font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:14pt;background-color:rgb(0,0,128);border:0;text-shadow:2px 2px 0 rgb(0,0,128)">
                  <div style="text-align:center">Send me the free series <span class="raquo">&raquo;</span></div>
                </button>
              </div>
            </div>
            <div class="leadpages-spacer">- -</div>
          </fieldset>
        </div>
        <div id="leadpages-privacy-policy" style="font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:10pt;">
          <div style="text-align:center"><i class="fa fa-lock"></i> We hate SPAM and promise to keep your email address safe.</div>
        </div>
      </div>
      <div class="leadpages-spacer">- -</div>
    </form>
  </div>
</div>
<div id="fade" class="black_overlay" data-close-lead></div>
