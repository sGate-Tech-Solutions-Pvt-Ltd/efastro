---
import { footerLinks, socialLinks, SITE, THEME_IMG } from "../data/home";
const year = new Date().getFullYear();
---
<div class="footer2">
  <div class="content"><div class="rowcustom"></div></div>
  <div class="container">
    <div class="col-sm-2">
      <a href="/"><img src={`${THEME_IMG}/footer_logo.png`} alt="EliteFitness" loading="lazy" /></a>
    </div>
    <div class="col-sm-8">
      <section id="nav_menu-2" class="widget widget_nav_menu">
        <div class="widget-wrap">
          <div class="menu-footermenu-container">
            <ul id="menu-footermenu" class="menu">
              {footerLinks.map((l) => (
                <li class="menu-item menu-item-type-custom menu-item-object-custom">
                  <a href={l.href} itemprop="url">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
      <section id="social-widget-2" class="widget Social_Widget">
        <div class="widget-wrap">
          <div class="socialmedia-buttons smw_center">
            {socialLinks.map((s) => (
              <a href={s.href} rel="nofollow" target="_blank">
                <img width="32" height="32" src={s.icon} alt={`Follow Us on ${s.label}`} title={`Follow Us on ${s.label}`}
                  style="opacity:0.8;" class="fade" loading="lazy" />
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
    <div class="col-sm-2 nor"></div>
  </div>
</div>
<footer class="site-footer" role="contentinfo" itemscope itemtype="http://schema.org/WPFooter">
  <div class="wrap">
    <p>©1997-{year} <a href={`${SITE}/`} style="color:#868686;">EliteFitness.com.</a> All rights reserved.</p>
  </div>
</footer>
